# Ignore everything that starts with a dot ('.?*' instead of '.*' so the
# pattern does not match the build context root '.' itself, which trips
# the CopyIgnoredFile check on 'COPY . .')
.?*
# Readme files and docs
README.rst
README_template.rst
generate_readme.sh
docs
COPYING
# Build file
Dockerfile*
makefile
nuts-node
development
data
e2e-tests
